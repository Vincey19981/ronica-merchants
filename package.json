{
  "name": "ronica-merchants",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"bun run --cwd ./server dev\" \"bun run --cwd ./client dev\"",
    "dev:client": "bun run --cwd ./client dev",
    "dev:server": "bun run --cwd ./server dev",
    "start": "bun run --cwd ./server start",
    "build": "bun run --cwd ./client build",
    "build:dev": "bun run --cwd ./client build:dev",
    "lint": "bun run --cwd ./client lint",
    "test": "bun run --cwd ./client test",
    "preview": "bun run --cwd ./client preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
